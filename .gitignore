# Rust
/target/
**/target/

# Trunk / wasm frontend build output
/frontend/dist/
/frontend/.trunk/

# Generated by the Tailwind CLI pre-build hook (see frontend/Trunk.toml) -
# this is a build artifact derived from frontend/styles/input.css, not
# hand-edited source.
/frontend/styles/tailwind.css

# Tauri bundle output
/src-tauri/target/

# Node (Tailwind CLI is a dev-only build dependency, no JS ships at runtime)
node_modules/

# Generated by flatpak/generate-sources.sh: the offline-vendoring source
# files for Flathub's no-network build (docs/FLATPAK.md §2.2/2.3), and the
# tool checkout/venv the script uses to produce them. Mechanically derived
# from Cargo.lock/package-lock.json every time the script runs - not meant
# to be hand-reviewed or committed here (their real long-term home, once a
# submission is accepted, is the separate github.com/flathub/<app-id> repo
# - see docs/FLATPAK.md §5.1).
/flatpak/cargo-sources.json
/flatpak/frontend-cargo-sources.json
/flatpak/node-sources.json
/flatpak/.cache/

# Local developer data - NEVER commit real system files here.
# This holds a private, untracked copy of a real /etc/fstab for manual
# sandbox testing. It is machine-specific and may contain personal paths
# (usernames, encrypted vault locations, hardware UUIDs) that must not
# end up in the public repository.
/dev-data/

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store

# Env files (see CONTRIBUTING.md for the .env.example convention)
.env

# Convenience symlink to wherever this machine's downstream packaging repo
# clones (Flathub, AUR, Debian/PPA...) actually live on disk - created by
# packaging/sync.sh, per-machine by nature (RUSTAB_PACKAGING_ROOT), never
# meant to be tracked.
/packaging/clones

# Local-only, not part of the public repo (by the maintainer's own choice):
# CLAUDE.md carries project instructions for AI coding assistants, and
# PROJECT_PLAN.md is the maintainer's private orchestration log for their
# own agents. Both are kept on disk for local use but deliberately excluded
# from git history/tracking so no one else who clones this repo sees or can
# modify them.
/CLAUDE.md
/PROJECT_PLAN.md
