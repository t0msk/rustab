#rustab synthetic fixture: entry descriptions carried by rustab's `# //`
#marker, alongside an ordinary unmarked comment. All paths and UUIDs are fake.

# // Project archive, only mounted when a backup runs
UUID=aaaa1111-bbbb-2222-cccc-333344445555 /mnt/archive ext4 noauto,nofail 0 2

#Ordinary comment: not a description, and must stay a comment line
LABEL=example-scratch /mnt/scratch xfs defaults 0 2

# // Shared media library on the house file server
//files.example.internal/media /mnt/media cifs noauto,credentials=/etc/rustab-fixture-creds,_netdev 0 0
